rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /wayfinder/locations {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email in [
          'admin@dxb-wayfinder.local',
          'ram@dxb-wayfinder.local'
        ];
    }
  }
}
